{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "AllowedHosts": "*",
  
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/log.txt", "rollingInterval": "Day" } }
    ]
  },

  "CarCatalogSettings": {
    "OfficialModels": [ 
      "Impreza",
      "Forester",
      "Outback",
      "Tucson",
      "Santa Fe",
      "Elantra",
      "Golf",
      "Passat",
      "Tiguan",
      "Polo" ],

    "UnofficialSuffix": "_unauthorized"
  }
}